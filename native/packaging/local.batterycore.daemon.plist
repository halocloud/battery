<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>local.batterycore.daemon</string>
    <key>ProgramArguments</key>
    <array><string>/Library/PrivilegedHelperTools/local.batterycore/batteryd</string></array>
    <key>MachServices</key><dict><key>local.batterycore.daemon</key><true/></dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>10</integer>
    <key>ExitTimeOut</key><integer>30</integer>
    <key>ProcessType</key><string>Background</string>
    <key>Umask</key><integer>63</integer>
</dict>
</plist>
